        "clsx": "^2.1.1",
        "date-fns": "latest",
        "lucide-react": "^1.18.0",
        "next": "latest",
        "radix-ui": "^1.5.0",
        "react": "latest",
        "react-dom": "latest",
        "shadcn": "^4.11.0",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "zod": "latest"
    },
    "devDependencies": {
        "@types/node": "latest",
        "@types/react": "latest",
        "@types/react-dom": "latest",
        "autoprefixer": "latest",
        "concurrently": "^10.0.3",
        "electron": "^42.4.0",
        "eslint": "latest",
